{
  "entities": {
    "AmanahUser": {
      "title": "AmanahUser",
      "description": "User profile metadata, Cloud Backup snapshot manifest, Sedekah Subuh streaks, embedded mutations, and app preferences",
      "type": "object",
      "properties": {
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp() when synced"
        },
        "updatedAtMillis": {
          "type": "number",
          "description": "Client epoch timestamp in milliseconds for snapshot display"
        },
        "deviceName": {
          "type": "string",
          "description": "Device model label that uploaded the cloud snapshot"
        },
        "totalBackedUpItems": {
          "type": "number",
          "description": "Total entity count across the 9 synchronized subcollections"
        },
        "backupChecksum": {
          "type": "string",
          "description": "SHA-256 verification checksum for snapshot integrity"
        },
        "sedekahStreak": {
          "type": "number",
          "description": "Current active consecutive daily Sedekah Subuh streak"
        },
        "sedekahLongest": {
          "type": "number",
          "description": "Longest consecutive daily Sedekah Subuh streak achieved"
        },
        "sedekahTotal": {
          "type": "number",
          "description": "Total cumulative amount donated in Sedekah Subuh"
        },
        "sedekahDays": {
          "type": "number",
          "description": "Total number of distinct days Sedekah Subuh was fulfilled"
        },
        "sedekahLastMillis": {
          "type": "number",
          "description": "Timestamp of last Sedekah Subuh contribution"
        },
        "sedekahHistoryJson": {
          "type": "string",
          "description": "JSON map of date strings to Sedekah Subuh amounts"
        },
        "walletMutationsJson": {
          "type": "string",
          "description": "JSON array of intra-wallet transfer mutation records"
        },
        "ibadahDepositsJson": {
          "type": "string",
          "description": "JSON array of Ibadah Goal funding deposit records"
        },
        "preferencesJson": {
          "type": "string",
          "description": "JSON serialized BackupPreferencesSnapshot including notification, security, theme, and shariah configs"
        }
      },
      "required": ["updatedAt"]
    },
    "WalletAccount": {
      "title": "WalletAccount",
      "description": "Financial wallet or bank account in Sharia double-entry ledger",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "institutionName": { "type": "string" },
        "accountNumber": { "type": "string" },
        "linkedAccountId": { "type": "string" },
        "colorHex": { "type": "number" },
        "isDefault": { "type": "boolean" },
        "notes": { "type": "string" },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()"
        }
      },
      "required": ["id", "name", "type", "updatedAt"]
    },
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "Double-entry Sharia ledger transaction entry with Hijri date metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "dateMillis": { "type": "number" },
        "hijriYear": { "type": "number" },
        "hijriMonth": { "type": "number" },
        "hijriDay": { "type": "number" },
        "description": { "type": "string" },
        "transactionType": { "type": "string" },
        "linesJson": { "type": "string" },
        "receiptJson": { "type": "string" },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()"
        }
      },
      "required": ["id", "dateMillis", "hijriYear", "hijriMonth", "hijriDay", "description", "transactionType", "linesJson", "updatedAt"]
    },
    "IbadahGoal": {
      "title": "IbadahGoal",
      "description": "Target Islamic spiritual financial accumulation goal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "targetAmount": { "type": "number" },
        "currentAccumulated": { "type": "number" },
        "targetHijri": { "type": "string" },
        "monthsRemaining": { "type": "number" },
        "linkedWalletId": { "type": "string" },
        "notes": { "type": "string" },
        "isCompleted": { "type": "boolean" },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()"
        }
      },
      "required": ["id", "type", "title", "targetAmount", "currentAccumulated", "updatedAt"]
    },
    "QardhRecord": {
      "title": "QardhRecord",
      "description": "Benevolent interest-free Islamic debt/loan (Qardh Hasan)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "counterpartyName": { "type": "string" },
        "totalAmount": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "agreementDateMillis": { "type": "number" },
        "dueDateMillis": { "type": "number" },
        "witnessName": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string" },
        "installmentsJson": { "type": "string" },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()"
        }
      },
      "required": ["id", "type", "counterpartyName", "totalAmount", "remainingAmount", "agreementDateMillis", "status", "updatedAt"]
    },
    "BudgetAllocation": {
      "title": "BudgetAllocation",
      "description": "Monthly Sharia spending budget cap and threshold per expense category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "accountId": { "type": "string" },
        "categoryName": { "type": "string" },
        "monthlyLimit": { "type": "number" },
        "iconKey": { "type": "string" },
        "alertThresholdPercent": { "type": "number" },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()"
        }
      },
      "required": ["id", "accountId", "categoryName", "monthlyLimit", "updatedAt"]
    },
    "InfaqRule": {
      "title": "InfaqRule",
      "description": "Automated Infaq calculation and Friday/Ramadan multiplier rule",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "targetCategory": { "type": "string" },
        "calculationType": { "type": "string" },
        "rate": { "type": "number" },
        "fixedAmount": { "type": "number" },
        "roundUpStep": { "type": "number" },
        "enableFridayMultiplier": { "type": "boolean" },
        "enableRamadanMultiplier": { "type": "boolean" },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()"
        }
      },
      "required": ["id", "title", "targetCategory", "calculationType", "rate", "updatedAt"]
    },
    "RecurringTransaction": {
      "title": "RecurringTransaction",
      "description": "Scheduled recurring bill, salary, or routine obligation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "categoryAccountId": { "type": "string" },
        "assetAccountId": { "type": "string" },
        "frequency": { "type": "string" },
        "dayOfMonthOrWeek": { "type": "number" },
        "customInfaqRate": { "type": "number" },
        "enableRoundUp": { "type": "boolean" },
        "roundUpStep": { "type": "number" },
        "isActive": { "type": "boolean" },
        "autoExecute": { "type": "boolean" },
        "lastExecutedDateMillis": { "type": "number" },
        "lastExecutedPeriodKey": { "type": "string" },
        "lastExecutionTimestamp": { "type": "number" },
        "nextDueDateMillis": { "type": "number" },
        "note": { "type": "string" },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()"
        }
      },
      "required": ["id", "title", "type", "amount", "categoryAccountId", "assetAccountId", "frequency", "dayOfMonthOrWeek", "nextDueDateMillis", "updatedAt"]
    },
    "InfaqDistributionRecord": {
      "title": "InfaqDistributionRecord",
      "description": "Disbursement record from Virtual Infaq Vault to Asnaf recipients",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "recipientName": { "type": "string" },
        "asnafCategory": { "type": "string" },
        "distributionDateMillis": { "type": "number" },
        "hijriDateString": { "type": "string" },
        "sourceAccountId": { "type": "string" },
        "programName": { "type": "string" },
        "receiptNumber": { "type": "string" },
        "notes": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()"
        }
      },
      "required": ["id", "amount", "recipientName", "asnafCategory", "distributionDateMillis", "sourceAccountId", "updatedAt"]
    },
    "RezekiNonTunaiRecord": {
      "title": "RezekiNonTunaiRecord",
      "description": "Non-cash blessing/gift record with optional gratitude infaq settlement",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "giverName": { "type": "string" },
        "category": { "type": "string" },
        "estimatedValue": { "type": "number" },
        "suggestedInfaqRate": { "type": "number" },
        "suggestedInfaqAmount": { "type": "number" },
        "isPaidInfaq": { "type": "boolean" },
        "paidJournalEntryId": { "type": "string" },
        "dateMillis": { "type": "number" },
        "hijriDateString": { "type": "string" },
        "notes": { "type": "string" },
        "createdAtMillis": { "type": "number" },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()"
        }
      },
      "required": ["id", "title", "category", "estimatedValue", "dateMillis", "updatedAt"]
    }
  },
  "firestore": {
    "/amanah_users/{userId}": {
      "schema": "AmanahUser",
      "description": "User profile metadata, Cloud Backup snapshot manifest, Sedekah Subuh streaks, and app preferences"
    },
    "/amanah_users/{userId}/wallets/{walletId}": {
      "schema": "WalletAccount",
      "description": "User wallets and bank accounts in Sharia double-entry ledger"
    },
    "/amanah_users/{userId}/journal_entries/{entryId}": {
      "schema": "JournalEntry",
      "description": "Sharia accounting double-entry journal transactions"
    },
    "/amanah_users/{userId}/ibadah_goals/{goalId}": {
      "schema": "IbadahGoal",
      "description": "Islamic financial worship goals like Qurban, Umrah, and Hajj"
    },
    "/amanah_users/{userId}/qardh_records/{recordId}": {
      "schema": "QardhRecord",
      "description": "Benevolent interest-free loans tracking (Qardh Hasan)"
    },
    "/amanah_users/{userId}/budgets/{budgetId}": {
      "schema": "BudgetAllocation",
      "description": "Monthly category budgets and spending thresholds"
    },
    "/amanah_users/{userId}/infaq_rules/{ruleId}": {
      "schema": "InfaqRule",
      "description": "Automated Infaq deduction and multiplier rules"
    },
    "/amanah_users/{userId}/recurring_transactions/{recurringId}": {
      "schema": "RecurringTransaction",
      "description": "Scheduled recurring transactions and reminders"
    },
    "/amanah_users/{userId}/infaq_distributions/{distributionId}": {
      "schema": "InfaqDistributionRecord",
      "description": "Virtual Infaq Vault distribution records"
    },
    "/amanah_users/{userId}/rezeki_non_tunai/{rezekiId}": {
      "schema": "RezekiNonTunaiRecord",
      "description": "Non-cash blessing and gratitude infaq records"
    }
  }
}
