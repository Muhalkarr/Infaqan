<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_cash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_cash_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💰 Ringkasan Kas Syariah"
        android:textColor="#10956A"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_cash_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Rp 0"
        android:textColor="#1A1C1E"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_cash_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Total Aset Kas &amp; Bank Aktif"
        android:textColor="#666666"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_cash_add_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#10956A"
        android:gravity="center"
        android:padding="6dp"
        android:text="+ Catat Transaksi"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
